{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vi-Code project manifest (vicode.yaml)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "top_module": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]{0,127}$"
        },
        "hdl": {
          "type": "string",
          "enum": [
            "Verilog",
            "SystemVerilog",
            "VHDL"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "part": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$"
        },
        "board": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:+-]{1,128}$"
        }
      }
    },
    "vivado": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "project"
          ]
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rtl": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "testbenches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]{0,127}$"
        },
        "simulator": {
          "type": "string",
          "enum": [
            "xsim"
          ]
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jobs": {
          "type": "integer",
          "minimum": 1
        },
        "run_synthesis": {
          "type": "boolean"
        },
        "run_implementation": {
          "type": "boolean"
        },
        "generate_bitstream": {
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "project"
  ]
}
